{
  "name": "adt-bot",
  "productName": "ADT Bot",
  "version": "1.1.0",
  "description": "Bring-your-own-key AI chat bots for web, desktop and mobile. Derived from Rakazo (Apache-2.0).",
  "license": "Apache-2.0",
  "author": "ADT Bot",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "preview": "npm run build && npm start",
    "test": "vitest run",
    "catalog": "node scripts/gen-catalog.mjs",
    "icons": "node scripts/icons.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder --mac --win --linux",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "brand": "node scripts/brand.mjs"
  },
  "build": {
    "appId": "app.adtbot.desktop",
    "productName": "ADT Bot",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "!**/*.test.mjs",
      "!**/*.test.cjs",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ADT Bot uses the microphone for voice input.",
        "NSAppleEventsUsageDescription": "ADT Bot sends keystrokes and reads window titles through System Events when you let a bot control this Mac."
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "ADT Bot"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    }
  },
  "devDependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@earendil-works/pi-ai": "^0.87.1",
    "@huggingface/transformers": "^4.3.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "homepage": "https://github.com/shoubhiksaha/adt-bot"
}
