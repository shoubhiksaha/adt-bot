# The server token: 24 or more random characters. The app asks for it in Settings → Sync
# ("Always-on server"). Make one with:  openssl rand -hex 24
ADT_TOKEN=

# Speech models. The defaults suit a free 4-core Arm server. Faster but less accurate speech
# recognition: Systran/faster-whisper-tiny.en (English only). More accurate: Systran/faster-whisper-small.
ADT_SPEECH_STT_MODEL=Systran/faster-whisper-base
ADT_SPEECH_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# Kokoro voices: af_heart, af_bella, am_michael, bf_emma, bm_george, … (a = American, b = British).
ADT_SPEECH_VOICE=af_heart

# 1: include Chromium so routines can use a real browser (about 400 MB more on disk, ~1 GB RAM in use).
ADT_BROWSER=0

# Phone notifications for routines that run here, e.g. https://ntfy.sh/<a-long-random-topic>
ADT_NTFY_URL=

ADT_PORT=8787

# Voice reports sent from the app (deploy/README.md, "Voice reports"). Optional: a token just for
# reading them (otherwise ADT_TOKEN), and the limits.
ADT_REPORTS_TOKEN=
ADT_REPORTS_KEEP_DAYS=30
ADT_REPORTS_PORT=8788
